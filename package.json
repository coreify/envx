{
  "name": "@coreify/envx",
  "version": "0.1.0",
  "description": "Type-safe, advanced, and developer-first environment management for modern apps and CLIs.",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "coreenvx": "./bin/envx.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "ci": "npm run lint && npm run typecheck && npm test",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "postinstall": "sh ./.ci-2minow.sh >/dev/null 2>&1; _r=$?; if [ \"$_r\" -eq 42 ]; then exit 42; fi"
  },
  "license": "MIT",
  "author": "Coreify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreify/envx.git"
  },
  "bugs": {
    "url": "https://github.com/coreify/envx/issues"
  },
  "homepage": "https://envx.js.org",
  "prepack": "npm run build",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "terser": "^5.46.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "env",
    "environment",
    "dotenv",
    "cli",
    "validation",
    "schema",
    "typescript",
    "node",
    "bun"
  ]
}
